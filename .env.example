ANTHROPIC_API_KEY=sk-ant-...
SLACK_TOKEN=xoxb-...
SLACK_CHANNEL=C0XXXXXXXX
GOOGLE_CREDENTIALS_PATH=/path/to/credential.json
GOOGLE_SHEET_ID=your_sheet_id_here
# Worksheet tab THIS deployment reads. One tab per environment/cluster on the
# same shared sheet, e.g. taraba / togo / bauchi. Defaults to Sheet1.
GOOGLE_SHEET_TAB=Sheet1
# Optional: per-environment Run Log tab. Defaults to the shared "Run Log".
# Set e.g. "Run Log taraba" to keep each env's run history separate.
GOOGLE_RUNLOG_TAB=Run Log
# Root Drive folder. Reports are auto-filed underneath as
#   <Instance>/<State>/<Campaign>/<Day N | Cumulative (Days 1-N)>
# Instance = GOOGLE_SHEET_TAB (naming the tab names the top folder);
# State = state_name column; Campaign = campaign_name column.
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
ES_URL=https://elasticsearch-data.es-cluster-v8:9200
ES_USER=your_es_user
ES_PASS=your_es_password
# ES index prefix. Leave UNSET for tenant-prefixed indices (Nigeria central,
# e.g. ba-project-task-index-v1). Set EMPTY for a dedicated single-tenant
# cluster with un-prefixed indices (Togo: project-task-index-v1).
#   ES_INDEX_PREFIX=
